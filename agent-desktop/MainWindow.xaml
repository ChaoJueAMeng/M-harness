<Window
    x:Class="MHarness.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MHarness.Desktop">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <CollectionViewSource x:Key="GroupedConversations" IsSourceGrouped="True" ItemsPath="Items"/>
            <Style x:Key="WorkspacePickerButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="M Bot">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/m-harness-icon.png" ShowAsMonochrome="False"/>
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ToolLogColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12,8,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button x:Name="NewChatButton"
                        Content="新建对话"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="NewChat_Click"
                        Margin="0,4,0,8"/>
                <TextBox x:Name="FilterBox"
                         Grid.Row="1"
                         PlaceholderText="过滤对话"
                         Margin="0,0,0,8"
                         TextChanged="FilterBox_TextChanged"/>
                <ListView x:Name="ConversationList"
                          Grid.Row="2"
                          ItemsSource="{Binding Source={StaticResource GroupedConversations}}"
                          SelectionMode="Single"
                          SelectionChanged="ConversationList_SelectionChanged"
                          IsItemClickEnabled="False">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderContainerStyle>
                                <Style TargetType="ListViewHeaderItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </GroupStyle.HeaderContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,8,0,4" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.72"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SidebarIconButtonStyle}"
                                                Click="AddWorkspaceChat_Click"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="在此工作区新建对话"
                                                AutomationProperties.Name="在此工作区新建对话">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" Opacity="0.72"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Conversation">
                            <StackPanel Spacing="2" Margin="0,4,0,4">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="在此工作区新建对话"
                                                        Click="AddWorkspaceChat_Click"
                                                        Tag="{x:Bind Workspace}"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="删除对话"
                                                        Click="DeleteConversation_Click"
                                                        Tag="{x:Bind Id}"/>
                                    </MenuFlyout>
                                </StackPanel.ContextFlyout>
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind RelativeTime}" Opacity="0.55" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Grid.Row="3"
                        Content="设置"
                        HorizontalAlignment="Stretch"
                        Click="Settings_Click"
                        Margin="0,8,0,0"/>
            </Grid>

            <Grid Grid.Column="1" Padding="16,8,16,12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel x:Name="WorkspacePicker"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                MaxWidth="440"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock Text="开始新对话"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="选择空白码本，或打开一个已有文件夹。"
                                   HorizontalAlignment="Center"
                                   Opacity="0.62"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <Button x:Name="StartScratchButton"
                                Style="{StaticResource WorkspacePickerButtonStyle}"
                                Click="StartScratch_Click"
                                ToolTipService.ToolTip="在临时码本中开始，不绑定项目目录"
                                AutomationProperties.Name="从空白开始">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE710;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="从空白开始" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="UseExistingFolderButton"
                                Style="{StaticResource WorkspacePickerButtonStyle}"
                                Click="UseExistingFolder_Click"
                                ToolTipService.ToolTip="选择本机文件夹作为工作区"
                                AutomationProperties.Name="使用已有文件夹">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="使用已有文件夹" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="EmptyState"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                MaxWidth="720"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyHint"
                                   Text="输入任务开始对话"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   Opacity="0.78"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="ChatState" Visibility="Collapsed">
                        <ScrollViewer x:Name="TranscriptScroll">
                            <StackPanel x:Name="MessagePanel" Spacing="16" Padding="4,4,8,12"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid x:Name="ComposerBar" Grid.Row="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="WorkspaceChip"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Click="BindWorkspace_Click"
                                    ToolTipService.ToolTip="绑定工作区目录"
                                    AutomationProperties.Name="绑定工作区目录">
                                <TextBlock x:Name="WorkspaceNameText" Text="未选择对话" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </Button>
                            <DropDownButton x:Name="ModeButton" Width="108" VerticalAlignment="Center" Content="Ask">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <RadioMenuFlyoutItem x:Name="AskModeItem" Text="Ask" GroupName="RunMode" IsChecked="True" Click="SelectAskMode_Click"/>
                                        <RadioMenuFlyoutItem x:Name="AgentModeItem" Text="Agent" GroupName="RunMode" Click="SelectAgentMode_Click"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <CheckBox x:Name="DryRunBox" Content="Dry-run" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoApproveBox" Content="自动批准" VerticalAlignment="Center"/>
                            <Button Content="回滚" Click="Rollback_Click"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ToolLogButton" Content="工具日志" Click="ToggleToolLog_Click"/>
                    </Grid>
                    <TextBox x:Name="PromptBox"
                             Grid.Row="1"
                             MinHeight="72"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             PlaceholderText="输入任务，Enter 发送，Shift+Enter 换行"/>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
                    <Button x:Name="StopButton" Grid.Column="1" Content="停止" IsEnabled="False" Click="Stop_Click"/>
                    <Button x:Name="SendButton" Grid.Column="2" Content="发送" Click="Send_Click"/>
                </Grid>
            </Grid>

            <Grid x:Name="ToolLogPane"
                  Grid.Column="2"
                  Visibility="Collapsed"
                  Padding="8,8,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="工具日志" Margin="0,0,0,6" Opacity="0.72"/>
                <ScrollViewer x:Name="LogScroll" Grid.Row="1">
                    <TextBox x:Name="LogBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
